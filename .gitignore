node_modules/
dist/
*.tsbuildinfo
.DS_Store

# Marketing pages generated by packages/web/site/build.mjs. They must live at
# their final paths for Vite to map them to the right output URLs — the source
# of truth is site/*.mjs, not these files.
packages/web/index.html
packages/web/app/
packages/web/fuer-freelancer/
packages/web/fuer-kleinunternehmen/
packages/web/fuer-vereine/
packages/web/sparkasse-kontoauszug-belege/
packages/web/datenschutz/
packages/web/haftungsausschluss/
packages/web/wissen/
packages/web/site/manifest.json
packages/web/public/sitemap.xml
packages/web/public/robots.txt

# Local env (e.g. VITE_RYBBIT_SITE_ID) — never commit
.env
.env.local
.env.*.local

# never commit real documents or local test fixtures (may contain personal data)
sample/
*.pdf
*.zip

# …except synthetic, authored fixtures (placeholder data only)
!packages/**/fixtures/**

# …and the fabricated demo statements + invoices shipped with the web app (no real data)
!packages/web/public/demo/
!packages/web/public/demo/**
